/* General Setup */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  line-height: 1.6;
  color: #333;
}

/* Header & Navbar */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 50px;
  background-color: #ffffff;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.logo a {
  font-size: 24px;
  font-weight: bold;
  color: #000080;
  text-decoration: none;
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 20px;
}

.nav-links a {
  text-decoration: none;
  color: #333;
  font-weight: bold;
}

.nav-links a:hover {
  color: #000080;
}

/* Hero Section */
.hero {
  background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1488646953014-85cb44e25828');
  background-size: cover;
  background-position: center;
  height: 80vh;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  color: white;
}

.hero-content h1 {
  font-size: 48px;
  margin-bottom: 10px;
}

.hero-content p {
  font-size: 20px;
  margin-bottom: 20px;
}

.btn {
  display: inline-block;
  padding: 10px 25px;
  background-color: #ff6b6b;
  color: white;
  text-decoration: none;
  border-radius: 5px;
  font-weight: bold;
}

.btn:hover {
  background-color: #ff4747;
}

/* Destinations Section */
.destinations-section {
  padding: 50px 20px;
  text-align: center;
  background-color: #f4f4f4;
}

.destinations-section h2 {
  font-size: 32px;
  margin-bottom: 30px;
  color: #000080;
}

.card-container {
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}

.card {
  background: white;
  border-radius: 8px;
  width: 300px;
  overflow: hidden;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.card img {
  width: 100%;
  height: 200px;
  object-fit: cover;
}

.card h3 {
  margin: 15px 0 10px;
  color: #333;
}

.card p {
  padding: 0 15px 20px;
  color: #666;
  font-size: 14px;
}

/* About Section */
.about-section {
  padding: 50px 20px;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
}

.about-section h2 {
  font-size: 32px;
  color: #000080;
  margin-bottom: 15px;
}

.about-section p {
  line-height: 1.6;
  color: #555;
  font-size: 16px;
}

/* Contact Section */
.contact-section {
  padding: 50px 20px;
  background-color: #f4f4f4;
  text-align: center;
}

.contact-section h2 {
  font-size: 32px;
  color: #000080;
  margin-bottom: 25px;
}

.contact-form {
  max-width: 500px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.contact-form input,
.contact-form textarea {
  padding: 12px;
  border: 1px solid #ccc;
  border-radius: 5px;
  font-size: 15px;
  width: 100%;
}

.contact-form button {
  border: none;
  cursor: pointer;
}
